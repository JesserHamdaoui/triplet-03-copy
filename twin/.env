# Twin local environment (used by twin/docker-compose.yml with mocks).
# Local development defaults only. Do not commit real secrets.

# ---- Where the other layers are. Unset: the mocks in this compose file. ----
# A partner on this machine is host.docker.internal, e.g. http://host.docker.internal:8003
# GUARDIAN_URL=http://mock-guardian:8000     # base address; readings are pushed there, its GET /events feeds the timeline
# BRAIN_URL=http://mock-brain:8000           # base address; its GET /events feeds the timeline
# GUARDIAN_EXTENDED_TYPES=cctv_anomaly,building_fire,unit_status   # our types the Guardian has registered (here, all: the mock takes any)
# BRAIN_EVENTS_URL=                          # our events for the City Brain's timeline (unset: BRAIN_URL/api/events; empty: off)
# GUARDIAN_INGEST_URL=                       # where readings go (default: GUARDIAN_URL/v1/readings)
# TWIN_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,twin:*,twin   # Host headers accepted at /mcp

# ---- Shared signing and auth keys ----
TWIN_HMAC_SECRET=dev-only-twin-secret
BRAIN_HMAC_SECRET=dev-only-brain-secret
GUARDIAN_HMAC_KEY=dev-only-guardian-secret
BRAIN_API_KEY=dev-only-brain-key
TWIN_API_KEY=dev-only-twin-key
OPS_API_KEY=dev-only-ops-key
TWIN_BRAIN_API_KEY=dev-only-twin-brain-key
TWIN_GUARDIAN_API_KEY=dev-only-twin-guardian-key
TWIN_OPERATOR_KEY=dev-only-operator-key
# ---- The city. ----
TWIN_SCENARIO=city                 # city | ped-hit | car-crash | building-fire | flood
TWIN_CARS=20                       # 0 to 47
TWIN_PEDESTRIANS=40                # 0 to 100
TWIN_CAR_CRASH_RISK=0.1            # 0 to 1, per car: runs red lights
TWIN_PED_HIT_RISK=0.1              # 0 to 1, per car: does not yield; per pedestrian: ignores signals
TWIN_FIRE_RISK=0                   # 0 to 1, per building: catches fire once, in the first few minutes
TWIN_FLOOD_RISK=0                  # 0 to 1, per street: its drain blocks and a downpour floods it, once
TWIN_DECISION=student              # student | random: how pedestrians and cars choose where to go next
TWIN_SEED=                         # set for a repeatable city
TWIN_EMIT_INTERVAL_S=1
# TWIN_REALISTIC_SENSORS=1           # sensors measure over a window and wobble (src/twin/sensor_model.py); 0: the engine's truth
# TWIN_READING_INTERVALS=traffic_camera=10,air_quality=10,rainfall=10,water_level=5,cctv_anomaly=5,building_fire=5   # the default, in seconds; empty: every tick

# ---- Host ports: the same as the real layers in the triplet. ----
VIEWER_PORT=8080
TWIN_PORT=8001
MOCK_BRAIN_PORT=8002
MOCK_GUARDIAN_PORT=8003
