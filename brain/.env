# Brain local environment.
# Local development defaults only. Do not commit real secrets.

# --- Shared signing and auth keys ---
TWIN_HMAC_SECRET=dev-only-twin-secret
BRAIN_HMAC_SECRET=dev-only-brain-secret
GUARDIAN_HMAC_KEY=dev-only-guardian-secret
BRAIN_API_KEY=dev-only-brain-key
TWIN_API_KEY=dev-only-twin-key
OPS_API_KEY=dev-only-ops-key

# Only needed with --llm: provider key from config/models.yaml (Groq by default).
GROQ_API_KEY=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

# Neo4j, the city graph (graph.backend: neo4j, default in compose).
NEO4J_PASSWORD=citybrain-local-pw

# Optional: where embedding models are cached (default ~/.cache/city-brain/fastembed)
FASTEMBED_CACHE_PATH=
