# Guardian local environment.
# Local development defaults only. Do not commit real secrets.

# --- Shared signing and auth keys ---
# Guardian accepts either TWIN_HMAC_KEY or TWIN_HMAC_SECRET for Twin signatures.
TWIN_HMAC_KEY=dev-only-twin-secret
GUARDIAN_HMAC_KEY=dev-only-guardian-secret
BRAIN_API_KEY=dev-only-brain-key
TWIN_API_KEY=dev-only-twin-key
OPS_API_KEY=dev-only-ops-key

# Optional overrides of config/guardian.yaml
# TWIN_BASE_URL=http://localhost:8101
# TWIN_TRANSPORT=rest
# TWIN_MODE=push
# LOG_DIR=../logs
# GUARDIAN_DB_PATH=./data/guardian.db
